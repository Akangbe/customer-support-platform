# Template only — no real values. Copy to .env.local and fill in real
# credentials there; .env.local is gitignored and never committed.
#
# Spring Boot does not read .env files automatically. These are meant to
# be exported as real environment variables (shell, IDE run config, or
# your deployment host's secrets UI) before running with -dev/-prod
# profiles. The `local` profile has safe built-in defaults and doesn't
# require any of these unless you want to point it at real infrastructure.

# --- Database (Postgres — Neon recommended) ---
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=
# WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v21.0

# --- Object storage (Cloudflare R2) ---
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# STORAGE_PRESIGNED_URL_TTL=PT15M

# --- CORS ---
# Real frontend origin — do not leave unset in staging/production, it
# silently falls back to http://localhost:3000 if forgotten.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain

# --- Optional ---
# APP_SCHEDULING_ENABLED=true

# --- Notification API rate limiting ---
# false (default) = process-local counters, no Redis needed. Set to true
# together with REDIS_* once more than one backend instance is running,
# otherwise each instance grants a caller the full per-minute budget.
# APP_RATE_LIMIT_REDIS_ENABLED=false
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- WhatsApp mock mode ---
# true swaps the Meta gateway for MockWhatsAppGateway: every send
# "succeeds" and nothing reaches Meta. Demos and tenant integration
# testing only — never set this in production.
# WHATSAPP_MOCK=false
